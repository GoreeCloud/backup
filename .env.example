# Development example only. Do not commit a real token.
GCB_LISTEN=127.0.0.1:8787
GCB_SOURCE_ROOT=/home/example/data-to-back-up
GCB_API_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Optional 32+ character DIFFERENT viewer-only token, no writes or provider quota calls.
# GCB_VIEW_TOKEN=REPLACE_WITH_AN_INDEPENDENT_32_PLUS_RANDOM_CHARACTER_TOKEN
GCB_WEB_DIR=web/dist
# Optional binary overrides
# GCB_KOPIA_BIN=kopia
# GCB_RCLONE_BIN=rclone

# Optional: enable contained restore. Must be an existing private absolute directory
# outside (and not an ancestor of) GCB_SOURCE_ROOT. Never point at live data.
# GCB_RESTORE_ROOT=/home/example/restore-workspace

# Optional: enable explicit Android system-picker selected-file backup.
# Existing empty private directory (0700), OUTSIDE GCB_SOURCE_ROOT and
# GCB_RESTORE_ROOT; never a shared folder. Inspect any crash leftovers manually.
# GCB_MOBILE_INGEST_ROOT=/home/example/private-mobile-ingest
